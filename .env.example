# API base URL (must include /api/v1)
VITE_API_URL=http://localhost:5001/api/v1
# Backend base URL for images/static assets (no /api/v1)
VITE_BE_URL=http://localhost:5001
# Stripe publishable key (from Stripe dashboard)
VITE_STRIPE_PUBLIC_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
# PayPal client ID (from PayPal developer dashboard)
VITE_PAYPAL_CLIENT_ID=
